# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=

# Admin password for your blog dashboard
ADMIN_PASSWORD=

# JWT secret for signing admin cookie (any random string, 32+ chars)
JWT_SECRET=

# Cloudinary credentials
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Your site URL (for metadata, sitemaps etc.)
NEXT_PUBLIC_SITE_URL=
